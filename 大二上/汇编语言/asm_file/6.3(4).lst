 0028  50			    PUSH AX             ; 保存 AX
 0029  56			    PUSH SI             ; 保存 SI
 002A  51			    PUSH CX             ; 保存 CX

				    ; 初始化循环
 002B  B9 000A			    MOV CX, 10          ; 数组长度为10，设置循环计数器
 002E  BE FFFF			    MOV SI, -1          ; 初始化 SI（变址寄存器）

 0031				Looop:
 0031  46			    INC SI              ; SI 指向下一个数组元素
 0032  8A 00			    MOV AL, [BX + SI]   ; 读取数组中当前元素到 AL
 0034  38 D0			    CMP AL, DL          ; 比较当前数组元素 AL 和 W
 0036  74 06			    JE case1            ; 如果 AL == W，跳转到 case1
 0038  7F 0C			    JG case2            ; 如果 AL > W，跳转到 case2
 003A  E2 F5			    LOOP Looop          ; 否则继续下一次循环
 003C  EB 08			    JMP case2           ; 如果遍历结束，跳转到 case2

 003E				case1:
				    ; 如果找到 W，输出 'Y'
 003E  B4 02			    MOV AH, 02          ; 设置 DOS 输出服务号
 0040  B2 59			    MOV DL, 'Y'         ; 设置输出字符 'Y'
 0042  CD 21			    INT 21H             ; 调用中断
 0044  EB 10			    JMP end_case        ; 跳转到结束处理

 0046				case2:
				    ; 如果未找到 W，将其插入到合适的位置
 0046  56			    PUSH SI             ; 将当前 SI 压栈保存
 0047  03 F1			    ADD SI, CX          ; 将 SI 移动到数组末尾位置
 0049				lop:
 0049  83 EE 01			    SUB SI, 1H          ; 从数组末尾向前遍历
 004C  8B 00			    MOV AX, [SI + BX]   ; 获取当前元素
 004E  89 40 01			    MOV [SI + BX + 1], AX ; 将当前元素后移一位
 0051  E2 F6			    LOOP lop            ; 循环直到插入点
				    ; 将 W 插入到数组中
 0053  5E			    POP SI              ; 恢复插入点的 SI
 0054  88 10			    MOV [SI + BX], DL   ; 将 W 写入插入点

 0056				end_case:
				    ; 恢复调用者现场
 0056  59			    POP CX              ; 恢复 CX
 0057  5E			    POP SI              ; 恢复 SI
 0058  58			    POP AX              ; 恢复 AX
 0059  5B			    POP BX              ; 恢复 BX
 005A  5A			    POP DX              ; 恢复 DX
 005B  5D			    POP BP              ; 恢复 BP
 005C  C2 0004			    RET 4               ; 返回，并清理栈上两个参数（数组地址和 W）

