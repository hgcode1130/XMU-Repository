 001D				FACT PROC
				    ; 保存调用者的栈帧信息
 001D  55			    PUSH BP             ; 保存 BP 寄存器
 001E  8B EC			    MOV BP, SP          ; 将 SP 保存到 BP（建立栈帧）

				    ; 保存调用者现场
 0020  52			    PUSH DX             ; 保存 DX 寄存器
 0021  53			    PUSH BX             ; 保存 BX 寄存器

