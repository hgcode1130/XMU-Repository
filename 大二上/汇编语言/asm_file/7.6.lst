				MOVESTR MACRO strN, dstr, sstr
				    MOV CX, strN          ; 设置字符传送的计数
				    LEA SI, sstr          ; 将源字符串地址加载到 SI
				    LEA DI, dstr          ; 将目标字符串地址加载到 DI
				    CLD                   ; 确保方向标志位清零
				    REP MOVSB             ; 使用 REP MOVSB 指令重复传送字符
				ENDM

